generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Unidade {
  id                  Int                  @id @default(autoincrement())
  nome                String
  sigla               String?
  endereco            String?
  cnes                String?
  cnpj                String?
  emailPrincipal      String?              @map("email_principal")
  emailAlternativo    String?              @map("email_alternativo")
  unidadeTipoId       Int?                 @map("unidade_tipo_id")
  criadoEm            DateTime?            @default(now()) @map("criado_em")
  atualizadoEm        DateTime?            @updatedAt @map("atualizado_em")
  perfilFuncional     PerfilFuncional[]
  solicitacaoUsuarios SolicitacaoUsuario[]
  unidadeTipo         UnidadeTipo?         @relation(fields: [unidadeTipoId], references: [id])
  unidadeHospitalar   UnidadeHospitalar?

  @@map("unidade")
}

model UnidadeHospitalar {
  unidadeId                          Int       @id @map("unidade_id")
  numeroLeitosUti                    Int?      @map("numero_leitos_uti")
  numeroLeitosUci                    Int?      @map("numero_leitos_uci")
  numeroLeitosEnfermaria             Int?      @map("numero_leitos_enfermaria")
  numeroLeitosSuporteVentilatorioPul Int?      @map("numero_leitos_suporte_ventilatorio_pulmonar")
  numeroLeitosExistenteTotal         Int?      @map("numero_leitos_existente_total")
  numeroLeitosCnesTotal              Int?      @map("numero_leitos_cnes_total")
  criadoEm                           DateTime? @default(now()) @map("criado_em")
  atualizadoEm                       DateTime? @updatedAt @map("atualizado_em")
  unidade                            Unidade   @relation(fields: [unidadeId], references: [id])

  @@map("unidade_hospitalar")
}

model UnidadeTipo {
  id           Int       @id @default(autoincrement())
  nome         String    @unique
  criadoEm     DateTime? @default(now()) @map("criado_em")
  atualizadoEm DateTime? @updatedAt @map("atualizado_em")
  unidades     Unidade[]

  @@map("unidade_tipo")
}

model Cargo {
  id                  Int                  @id @default(autoincrement())
  nome                String
  criadoEm            DateTime?            @default(now()) @map("criado_em")
  atualizadoEm        DateTime?            @updatedAt @map("atualizado_em")
  perfilFuncional     PerfilFuncional[]
  solicitacaoUsuarios SolicitacaoUsuario[]

  @@map("cargo")
}

model Usuario {
  id                           String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                         String
  matricula                    String                        @unique
  cpf                          String                        @unique
  email                        String?
  perfilFuncionalId            Int                           @map("perfil_funcional_id")
  criadoEm                     DateTime?                     @default(now()) @map("criado_em")
  atualizadoEm                 DateTime?                     @updatedAt @map("atualizado_em")
  criadoPorId                  String?                       @db.Uuid
  origemSolicitacaoId          Int?                          @unique
  acesso                       Acesso?
  solicitacaoUsuarios          SolicitacaoUsuario[]
  criadoPor                    Usuario?                      @relation("AuditoriaCriacao", fields: [criadoPorId], references: [id])
  usuariosCriados              Usuario[]                     @relation("AuditoriaCriacao")
  origemSolicitacao            SolicitacaoUsuario?           @relation("UsuarioGerado", fields: [origemSolicitacaoId], references: [id])
  perfilFuncional              PerfilFuncional               @relation(fields: [perfilFuncionalId], references: [id])
  historicoSolicitacaoUsuarios HistoricoSolicitacaoUsuario[]

  @@map("usuario")
}

model Acesso {
  id             Int             @id @default(autoincrement())
  usuarioId      String          @unique @map("usuario_id") @db.Uuid
  senha          String
  ultimoLogin    DateTime?       @map("ultimo_login")
  criadoEm       DateTime?       @default(now()) @map("criado_em")
  atualizadoEm   DateTime?       @updatedAt @map("atualizado_em")
  usuario        Usuario         @relation(fields: [usuarioId], references: [id])
  tokensDeAcesso TokenDeAcesso[]

  @@map("acesso")
}

model TokenDeAcesso {
  id           Int       @id @default(autoincrement())
  acessoId     Int       @map("acesso_id")
  token        String    @unique
  validoAte    DateTime  @map("valido_ate")
  expiradoEm   DateTime? @map("expirado_em")
  criadoEm     DateTime? @default(now()) @map("criado_em")
  atualizadoEm DateTime? @updatedAt @map("atualizado_em")
  acesso       Acesso    @relation(fields: [acessoId], references: [id])

  @@map("token_de_acesso")
}

model Setor {
  id                  Int                  @id @default(autoincrement())
  nome                String
  criadoEm            DateTime?            @default(now()) @map("criado_em")
  atualizadoEm        DateTime?            @updatedAt @map("atualizado_em")
  sigla               String?
  perfilFuncional     PerfilFuncional[]
  solicitacaoUsuarios SolicitacaoUsuario[]

  @@map("setor")
}

model Area {
  id                  Int                  @id @default(autoincrement())
  nome                String
  criadoEm            DateTime?            @default(now()) @map("criado_em")
  atualizadoEm        DateTime?            @updatedAt @map("atualizado_em")
  perfilFuncional     PerfilFuncional[]
  solicitacaoUsuarios SolicitacaoUsuario[]

  @@map("area")
}

model Modulo {
  id            Int            @id @default(autoincrement())
  nome          String
  criadoEm      DateTime?      @default(now()) @map("criado_em")
  atualizadoEm  DateTime?      @updatedAt @map("atualizado_em")
  controlesRbac ControleRbac[]

  @@map("modulo")
}

model PerfilFuncional {
  id            Int            @id @default(autoincrement())
  unidadeId     Int            @map("unidade_id")
  setorId       Int            @map("setor_id")
  cargoId       Int            @map("cargo_id")
  areaId        Int?           @map("area_id")
  criadoEm      DateTime?      @default(now()) @map("criado_em")
  atualizadoEm  DateTime?      @updatedAt @map("atualizado_em")
  controlesRbac ControleRbac[]
  area          Area?          @relation(fields: [areaId], references: [id])
  cargo         Cargo          @relation(fields: [cargoId], references: [id])
  setor         Setor          @relation(fields: [setorId], references: [id])
  unidade       Unidade        @relation(fields: [unidadeId], references: [id])
  usuarios      Usuario[]

  @@map("perfil_funcional")
}

model ControleRbac {
  id                Int              @id @default(autoincrement())
  perfilFuncionalId Int?             @map("perfil_funcional_id")
  moduloId          Int?             @map("modulo_id")
  visualizar        Boolean?
  criar             Boolean?
  editar            Boolean?
  deletar           Boolean?
  criadoEm          DateTime?        @default(now()) @map("criado_em")
  atualizadoEm      DateTime?        @updatedAt @map("atualizado_em")
  modulo            Modulo?          @relation(fields: [moduloId], references: [id])
  PerfilFuncional   PerfilFuncional? @relation(fields: [perfilFuncionalId], references: [id])

  @@unique([perfilFuncionalId, moduloId])
  @@map("controle_rbac")
}

model SolicitacaoUsuario {
  id                    Int                           @id @default(autoincrement())
  usuarioSolicitanteId  String                        @db.Uuid
  usuarioSolicitadoNome String
  unidadeId             Int
  setorId               Int
  areaId                Int?
  cargoId               Int
  cpf                   String                        @unique
  dataNascimento        DateTime
  email                 String                        @unique
  matricula             String                        @unique
  telefone              String
  detalhe               String
  statusSolicitacao     StatusSolicitacaoUsuario
  usuarioFinalId        String?                       @unique @db.Uuid
  feedbackResultado     String?
  criadoEm              DateTime?                     @default(now()) @map("criado_em")
  atualizadoEm          DateTime?                     @updatedAt @map("atualizado_em")
  historicoSolicitacao  HistoricoSolicitacaoUsuario[]
  area                  Area?                         @relation(fields: [areaId], references: [id])
  cargo                 Cargo                         @relation(fields: [cargoId], references: [id])
  setor                 Setor                         @relation(fields: [setorId], references: [id])
  unidade               Unidade                       @relation(fields: [unidadeId], references: [id])
  usuarioSolicitante    Usuario                       @relation(fields: [usuarioSolicitanteId], references: [id])
  usuarioFinal          Usuario?                      @relation("UsuarioGerado")

  @@map("solicitacao_usuario")
}

model HistoricoSolicitacaoUsuario {
  id                 Int                               @id @default(autoincrement())
  solcitacaoId       Int
  autorId            String                            @db.Uuid
  evento             String // Vamos padronizar o texto que entra aqui
  observacao         String? // Detalhes extras (ex: motivo da rejeição)
  // Metadados visuais (opcional, mas ajuda o front)
  categoria          CategoriaEventoUsuarioSolicitacao @default(INFO)
  criadoEm           DateTime?                         @default(now()) @map("criado_em")
  atualizadoEm       DateTime?                         @updatedAt @map("atualizado_em")
  autor              Usuario                           @relation(fields: [autorId], references: [id])
  solicitacaoUsuario SolicitacaoUsuario                @relation(fields: [solcitacaoId], references: [id])

  @@map("historico_solicitacao_usuario")
}

enum TipoServico {
  URGENCIA_EMERGENCIA
  ATENCAO_PRIMARIA
  AMBULATORIO
  HOSPITALAR
  LABORATORIO

  @@map("tipo_servico")
}

enum StatusSolicitacaoUsuario {
  APROVADO
  PENDENTE
  REJEITADO
}

enum CategoriaEventoUsuarioSolicitacao {
  SUCESSO
  INFO
  ALERTA
  SISTEMA
}
