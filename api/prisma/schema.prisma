generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Unidade {
  id                     Int                     @id @default(autoincrement())
  nome                   String
  sigla                  String?
  endereco               String?
  cnes                   String?
  cnpj                   String?
  emailPrincipal         String?                 @map("email_principal")
  emailAlternativo       String?                 @map("email_alternativo")
  unidadeTipoId          Int?                    @map("unidade_tipo_id")
  criadoEm               DateTime?               @default(now()) @map("criado_em")
  atualizadoEm           DateTime?               @updatedAt @map("atualizado_em")
  unidadeTipo            UnidadeTipo?            @relation(fields: [unidadeTipoId], references: [id])
  unidadeHospitalar      UnidadeHospitalar?
  unidadeSetorAreaCargos UnidadeSetorAreaCargo[]

  @@map("unidade")
}

model UnidadeHospitalar {
  unidadeId                          Int       @id @map("unidade_id")
  numeroLeitosUti                    Int?      @map("numero_leitos_uti")
  numeroLeitosUci                    Int?      @map("numero_leitos_uci")
  numeroLeitosEnfermaria             Int?      @map("numero_leitos_enfermaria")
  numeroLeitosSuporteVentilatorioPul Int?      @map("numero_leitos_suporte_ventilatorio_pulmonar")
  numeroLeitosExistenteTotal         Int?      @map("numero_leitos_existente_total")
  numeroLeitosCnesTotal              Int?      @map("numero_leitos_cnes_total")
  criadoEm                           DateTime? @default(now()) @map("criado_em")
  atualizadoEm                       DateTime? @updatedAt @map("atualizado_em")
  unidade                            Unidade   @relation(fields: [unidadeId], references: [id])

  @@map("unidade_hospitalar")
}

model UnidadeTipo {
  id           Int       @id @default(autoincrement())
  nome         String    @unique
  criadoEm     DateTime? @default(now()) @map("criado_em")
  atualizadoEm DateTime? @updatedAt @map("atualizado_em")
  unidades     Unidade[]

  @@map("unidade_tipo")
}

model Cargo {
  id                     Int                     @id @default(autoincrement())
  nome                   String?
  criadoEm               DateTime?               @default(now()) @map("criado_em")
  atualizadoEm           DateTime?               @updatedAt @map("atualizado_em")
  unidadeSetorAreaCargos UnidadeSetorAreaCargo[]

  @@map("cargo")
}

model Usuario {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                    String
  matricula               String                @unique
  cpf                     String                @unique
  email                   String?
  unidadeSetorAreaCargoId Int                   @map("unidade_setor_area_cargo_id")
  criadoEm                DateTime?             @default(now()) @map("criado_em")
  atualizadoEm            DateTime?             @updatedAt @map("atualizado_em")
  acesso                  Acesso?
  unidadeSetorAreaCargo   UnidadeSetorAreaCargo @relation(fields: [unidadeSetorAreaCargoId], references: [id])

  @@map("usuario")
}

model Acesso {
  id             Int             @id @default(autoincrement())
  usuarioId      String          @unique @map("usuario_id") @db.Uuid
  senha          String
  ultimoLogin    DateTime?       @map("ultimo_login")
  criadoEm       DateTime?       @default(now()) @map("criado_em")
  atualizadoEm   DateTime?       @updatedAt @map("atualizado_em")
  usuario        Usuario         @relation(fields: [usuarioId], references: [id])
  tokensDeAcesso TokenDeAcesso[]

  @@map("acesso")
}

model TokenDeAcesso {
  id           Int       @id @default(autoincrement())
  acessoId     Int       @map("acesso_id")
  token        String    @unique
  validoAte    DateTime  @map("valido_ate")
  expiradoEm   DateTime? @map("expirado_em")
  criadoEm     DateTime? @default(now()) @map("criado_em")
  atualizadoEm DateTime? @updatedAt @map("atualizado_em")
  acesso       Acesso    @relation(fields: [acessoId], references: [id])

  @@map("token_de_acesso")
}

model Setor {
  id                     Int                     @id @default(autoincrement())
  nome                   String
  criadoEm               DateTime?               @default(now()) @map("criado_em")
  atualizadoEm           DateTime?               @updatedAt @map("atualizado_em")
  unidadeSetorAreaCargos UnidadeSetorAreaCargo[]

  @@map("setor")
}

model Area {
  id                     Int                     @id @default(autoincrement())
  nome                   String
  criadoEm               DateTime?               @default(now()) @map("criado_em")
  atualizadoEm           DateTime?               @updatedAt @map("atualizado_em")
  unidadeSetorAreaCargos UnidadeSetorAreaCargo[]

  @@map("area")
}

model Modulo {
  id            Int            @id @default(autoincrement())
  nome          String
  criadoEm      DateTime?      @default(now()) @map("criado_em")
  atualizadoEm  DateTime?      @updatedAt @map("atualizado_em")
  controlesRbac ControleRbac[]

  @@map("modulo")
}

model UnidadeSetorAreaCargo {
  id            Int            @id @default(autoincrement())
  unidadeId     Int            @map("unidade_id")
  setorId       Int            @map("setor_id")
  cargoId       Int            @map("cargo_id")
  areaId        Int?           @map("area_id")
  criadoEm      DateTime?      @default(now()) @map("criado_em")
  atualizadoEm  DateTime?      @updatedAt @map("atualizado_em")
  controlesRbac ControleRbac[]
  area          Area?          @relation(fields: [areaId], references: [id])
  cargo         Cargo          @relation(fields: [cargoId], references: [id])
  setor         Setor          @relation(fields: [setorId], references: [id])
  unidade       Unidade        @relation(fields: [unidadeId], references: [id])
  usuarios      Usuario[]

  @@map("unidade_setor_area_cargo")
}

model ControleRbac {
  id                      Int                    @id @default(autoincrement())
  unidadeSetorAreaCargoId Int?                   @map("unidade_setor_area_cargo_id")
  moduloId                Int?                   @map("modulo_id")
  visualizar              Boolean?
  criar                   Boolean?
  editar                  Boolean?
  deletar                 Boolean?
  criadoEm                DateTime?              @default(now()) @map("criado_em")
  atualizadoEm            DateTime?              @updatedAt @map("atualizado_em")
  modulo                  Modulo?                @relation(fields: [moduloId], references: [id])
  unidadeSetorAreaCargo   UnidadeSetorAreaCargo? @relation(fields: [unidadeSetorAreaCargoId], references: [id])

  @@unique([unidadeSetorAreaCargoId, moduloId])
  @@map("controle_rbac")
}

enum TipoServico {
  URGENCIA_EMERGENCIA
  ATENCAO_PRIMARIA
  AMBULATORIO
  HOSPITALAR
  LABORATORIO

  @@map("tipo_servico")
}
